# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Content-addressed binary layer cache (day10 format)"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.2.0"}
  "eio" {>= "1.0"}
  "osrel" {= version}
  "opam-format" {>= "2.2.0"}
  "jsont" {>= "0.2"}
  "bytesrw" {>= "0.2"}
  "sqlite3"
  "cmdliner"
  "eio_main" {>= "1.0"}
  "fmt"
  "logs"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
